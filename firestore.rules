rules_version = '2';
// =====================================================================
//  Firestore セキュリティルール（コード監査ベース版）
//  方針：
//   1) 未認証（匿名）からの「書込み」を全面禁止（現状の最大の穴＝誰でも改ざん/削除可 を塞ぐ）
//   2) 非公開データ（サブスク/各種バックアップ）は本人のみ read/write
//   3) 公開ソーシャル（投稿/プロフィール/ルート等）は read 公開のまま（＝閲覧は壊さない）、
//      write は「認証済み」に限定（フォロー/いいね等は他人配下へ書くため owner 不可）
//   4) 自動ID＋フィールドでクエリする個人データ（退会チェック/通知/ブロック）は
//      docID=uid ではないので「認証済み read/create」で対応（←前回ここを誤り、ログイン不能に）
//   5) マスタ（スタンプラリー/道の駅/グリッド）は read 公開・クライアント write 不可（管理は Admin SDK）
//
//  ※ 列挙していないコレクションは既定で全拒否（default deny）。
//    新コレクションを追加したらここにも追記すること（漏れると its アクセスが壊れる）。
//  ※ 監査は iOS(touringSpotShare)/Web(public) の .collection 使用を全走査して作成。
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    // 開発者（フィードバック/通報ビューア等の DEV ツール用）。メールで判定。増える場合は配列に追記。
    function isDev() {
      return request.auth != null
          && request.auth.token.email in [
               "little_busters_rin_takuya@yahoo.co.jp"
             ];
    }
    // subscriptions/{uid} の StoreKit解決フィールドの妥当性検証（tier/isSubscribed整合・型・期限上限）。
    function isValidSubscriptionWrite(data) {
      return data.tier in ['free', 'plus', 'pro']
        && data.isSubscribed == (data.tier != 'free')
        && (!('productID' in data) || data.productID is string)
        && (!('expiration' in data) ||
              (data.expiration is timestamp && data.expiration < request.time + duration.value(400, 'd')));
    }

    // ========== 非公開：本人のみ read/write（docID = uid） ==========
    // サブスク状態。以前は isOwner のみでフィールド無検証＝クライアントが tier/isSubscribed を
    // 直接書いてStoreKitを経由せずPro/Plusを不正取得できた。クライアントが書ける範囲を
    // StoreKit解決フィールドのみに限定し、referralBonusExpiresAt/referralBonusGrantedCount
    // （紹介報酬、processReferralReward が Admin SDK で付与）は許可リスト外＝クライアント書込み不可にする。
    // 【既知の限界】実在する product ID 文字列を知っていれば依然として雑な偽装は可能。
    // 根本解決には StoreKit 2 のサーバー側署名検証が必要（別途の取り組みとして記録）。
    match /subscriptions/{uid} {
      allow read: if isOwner(uid);
      // create: 初回書込みは resource（既存データ）が無いため diff() が使えない。
      // 新規ドキュメントの全キーを許可リストで検証する（referralBonusExpiresAt 等の
      // Cloud Function専用フィールドを初回書込みで混入させないため）。
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['tier', 'isSubscribed', 'productID', 'expiration', 'updatedAt', 'platform'])
        && isValidSubscriptionWrite(request.resource.data);
      // update: 既存データとの差分キーのみ許可リストで検証（merge:true 書込みに対応）。
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['tier', 'isSubscribed', 'productID', 'expiration', 'updatedAt', 'platform'])
        && isValidSubscriptionWrite(request.resource.data);
    }
    // 紹介報酬：月次カウンタ台帳。本人は自分の達成状況を読めるが書けない（Cloud Functions専用）。
    match /referralRewards/{uid} { allow read: if isOwner(uid); allow write: if false; }
    // 紹介報酬：付与イベント台帳（冪等性ガード兼監査ログ）。完全非公開。
    match /referralRewardEvents/{referredUid} { allow read, write: if false; }
    match /route_backups/{uid}/{doc=**}   { allow read, write: if isOwner(uid); } // ルートバックアップ本体＋配下(routes等)
    match /selectedLocationBackup/{uid}   { allow read, write: if isOwner(uid); } // 選択スポットのバックアップ
    match /micinoEkiBackUp/{uid}          { allow read, write: if isOwner(uid); } // 道の駅コレクションのバックアップ

    // users/{uid}：touringPlans / stamps。プロフィールで他人分も閲覧されうるので read 公開、write は本人のみ
    match /users/{uid}/{doc=**} {
      allow read:  if true;
      allow write: if isOwner(uid);
    }

    // ========== 自動ID＋フィールドでクエリする個人データ（本人限定を docID で表現できない） ==========
    // 退会予約：ログイン成功後に whereField("deletingUserID"==uid) で検索（前回ここを本人限定にしてログイン不能化）
    match /user_deleting_scheduled/{id} {
      allow read:   if signedIn();
      allow create: if signedIn();
    }
    match /pushNatification/{id} { allow read, write: if signedIn(); } // 通知（destinationUserID で検索）
    match /blockList/{id}        { allow read, write: if signedIn(); } // ブロック（reportUserID/blockUserID で検索）

    // ========== 問い合わせ/メッセージ（当事者間・認証必須） ==========
    match /inquiry/{id}       { allow read, write: if signedIn(); }
    match /inquiryDetail/{id} { allow read, write: if signedIn(); }

    // ========== 送信：作成は認証済みのみ・閲覧は開発者のみ（DEVビューア用） ==========
    match /user_feedback/{id}  { allow read: if isDev(); allow create: if signedIn(); }
    match /micro_feedback/{id} { allow read: if isDev(); allow create: if signedIn(); }
    match /reportInf/{id}      { allow read: if isDev(); allow create: if signedIn(); }

    // ========== マスタ：全員 read・クライアント write 不可（管理は Admin SDK / コンソール） ==========
    match /stampRallies/{id}         { allow read: if true; allow write: if false; }
    match /MicinoEki/{id}            { allow read: if true; allow write: if false; }
    match /grids_metadata/{id}       { allow read: if true; allow write: if false; }
    match /grids_metadata_empty/{id} { allow read: if true; allow write: if false; }
    match /grid_boundaries/{id}      { allow read: if true; allow write: if false; }
    // おすすめ道路（開発者がローカルで生成して配信）。
    // アプリが読むのは _index の1件だけで、本体は Storage の Json/road_recommend/ にある。
    // 投入は admin/importRoadRecommend.js（Admin SDK）。
    match /road_recommend/{id}       { allow read: if true; allow write: if false; }
    // 道路名の一覧（走破率・ロードデックスの分母）。
    // ジオメトリを含まないので軽い（全国で1.8MB）。本体は Storage の Json/road_names/。
    // グリッドを持っていない端末（海外・未ダウンロード）でも走破率を出すために使う。
    // 生成は admin/buildRoadNames.js、投入は admin/importRoadNames.js（Admin SDK）。
    match /road_names/{id}          { allow read: if true; allow write: if false; }
    // 二輪の通行規制（開発者が確認して登録したもの）。
    // 都道府県警察／二普協の公開情報をもとに、区間形状はこちらで作っている。
    // 投入は admin/importRestrictions.js（Admin SDK）。
    match /road_restrictions/{id}    { allow read: if true; allow write: if false; }

    // ========== 公開ソーシャル：read 公開・write 認証済みのみ ==========
    // プロフィール（＋ badges / followUser / yaehCount 等の配下）。フォロー/問い合わせで他人配下にも書くため write=認証済み
    match /userInfo/{uid} {
      allow read: if true;
      allow write: if signedIn();
      match /{doc=**} {
        allow read: if true;
        allow write: if signedIn();
      }
    }
    // 統計・走破率（docID=uid・本人の進捗）：read 公開、write は本人
    match /user_stats/{uid}      { allow read: if true; allow write: if isOwner(uid); }
    match /road_completion/{uid} { allow read: if true; allow write: if isOwner(uid); }

    // 投稿スポット（＋ favoriteCount / withGotoComment / locationTapRecord / yaehCount 等の配下）
    match /imagedownload/{id}/{doc=**} { allow read: if true; allow write: if signedIn(); }
    // 共有ルート（＋配下）
    match /shared_routes/{id}/{doc=**} { allow read: if true; allow write: if signedIn(); }

    // 口コミ
    match /wordOfMouth/{id}        { allow read: if true; allow write: if signedIn(); }
    match /wordOfMouthCounter/{id} { allow read: if true; allow write: if signedIn(); }
    // コメント/いいね（トップレベル版。スポット配下版は imagedownload の配下ルールで許可）
    match /withGotoComment/{id} { allow read: if true; allow write: if signedIn(); }
    match /favoriteCount/{id}   { allow read: if true; allow write: if signedIn(); }
    match /commentDetails/{id}  { allow read: if signedIn(); allow write: if signedIn(); }
    match /commentRoom/{id}     { allow read: if signedIn(); allow write: if signedIn(); }

    // ルート
    match /routes/{id}         { allow read: if true;      allow write: if signedIn(); }
    match /routes_private/{id} { allow read: if signedIn(); allow write: if signedIn(); }

    // ブログ（公式運営が作成。一般ユーザーは投稿しない = 記事の作成/全体編集/削除は開発者限定）。
    // 詳細ページはログイン前でも閲覧数(views)を+1する（未ログイン訪問者が大半のため必須）。
    // いいね(likes)は要ログインだが、一般ユーザーでも押せる必要がある。
    // → フィールド単位で許可範囲を分け、記事本文等の改ざん・削除は isDev() のみに限定する。
    match /blog_posts/{id} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);              // 誰でも閲覧数のみ
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']); // ログイン済みならいいねのみ
      allow create, update, delete: if isDev();  // 記事本文・削除は開発者(公式ブログ管理者)のみ
    }
  }
}
